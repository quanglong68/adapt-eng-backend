# Copy thành .env rồi điền giá trị thật (file .env KHÔNG commit).
# Xem giá trị mẫu trong REFACTOR_PLAN.md mục 10.

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=adapt_eng_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- JPA ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# --- JWT (chuỗi base64 >= 256-bit, đổi ở prod!) ---
JWT_SECRET=change-me-base64-256bit
JWT_EXPIRATION_MS=86400000

# --- Gemini AI ---
GEMINI_API_KEY=change-me
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent
# Thứ tự model fallback khi hết quota (cách nhau dấu phẩy)
GEMINI_API_MODELS=gemini-2.5-flash,gemini-3.5-flash,gemini-3.8-flash
# Các key dự phòng, cách nhau dấu phẩy (không commit key thật)
API_KEYS=key-1,key-2

# --- VNPay ---
VNPAY_TMN_CODE=change-me
VNPAY_HASH_SECRET=change-me
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment-result
VNPAY_IPN_URL=http://localhost:8080/api/v1/payment/vnpay-ipn

# --- HuggingFace (vẽ ảnh Writing) ---
HUGGINGFACE_API_KEY=change-me
HUGGINGFACE_API_URL=https://api-inference.huggingface.co/models/black-forest-labs/FLUX.1-schnell

# --- Cloudinary (lưu ảnh Writing) ---
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me
